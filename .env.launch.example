# Server only. Never put these in VITE_* or commit actual values.
DATABASE_URL=postgresql://USER:PASSWORD@SUPABASE_HOST:5432/postgres?sslmode=verify-full
APP_ORIGIN=https://YOUR-STAGING-DOMAIN
SESSION_PEPPER=REPLACE_WITH_64_HEX_CHARACTERS_FROM_OPENSSL_RAND_HEX_32
TWILIO_ACCOUNT_SID=AC_REPLACE
TWILIO_AUTH_TOKEN=REPLACE
TWILIO_VERIFY_SERVICE_SID=VA_REPLACE
MAPBOX_TOKEN=
# Optional for native sign-in/GPS; required only when enabling Mapbox search/routes.
# Enable only after confirming the applicable provider license/usage rights.
MAPBOX_USAGE_APPROVED=false
# Opt-in staging only. Manually approve driver and complete privacy review.
TRACKING_STAGING_ENABLED=false
# Leave false unless provider expressly approves durable route-result storage.
MAPBOX_QUOTE_STORAGE_APPROVED=false
# Operator-reviewed bounds; no geographic defaults are supplied.
SERVICE_BOUNDS={"south":0,"north":1,"west":0,"east":1}
RETURN_ZONES=[]
PORT=4001
# Paynow deliberately NOT activated; see docs/GO-LIVE.md.
