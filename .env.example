NODE_ENV=development
PORT=4000
DEMO_MODE=true
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ridedora
WEB_ORIGIN=http://localhost:5173
# Mobile uses the machine's LAN IP, never localhost on a physical phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
EXPO_PUBLIC_MAPBOX_TOKEN=
OTP_PROVIDER_API_KEY=
ECOCASH_MERCHANT_ID=
ECOCASH_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOCUMENT_BUCKET=
# Admin-only fake settlement for isolated local testing. Keep false for public demos.
DEMO_BILLING_ENABLED=false
# DEMO_ADMIN_PHONE=+263770000099
# The subscription amount is deliberately fixed server-side: USD 2500 minor / 30 days.
