{
  "name": "ride-dora",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "node --env-file=.env apps/api/server.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:api": "node tests/run-api-smoke.mjs",
    "test:web": "playwright test",
    "test:db": "node tests/db-driver-pass.mjs",
    "start:launch": "node apps/launch-api/server.js",
    "build:launch": "vite build --config vite.launch.config.js",
    "db:migrate": "node ops/migrate.mjs",
    "test:launch": "node --test --test-concurrency=1 tests/launch/*.test.js",
    "dev:maps": "vite --config vite.launch.config.js",
    "test:maps": "playwright test --config playwright.maps.config.js",
    "test:tracking": "playwright test --config playwright.tracking.config.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
